{
  "name": "lettuce-mcp",
  "version": "0.1.1",
  "mcpName": "au.com.primitiveai/lettuce",
  "description": "Let us check first. Approvals, time limits and receipts for what your AI agent does through MCP.",
  "type": "module",
  "bin": {
    "lettuce": "./dist/src/cli.js",
    "lettuce-mcp": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run format:check && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "approvals",
    "permissions",
    "claude-code",
    "cursor",
    "audit-log"
  ],
  "author": "Primitive <hello@primitiveai.com.au>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Primitivelabai/lettuce.git"
  },
  "homepage": "https://punnet.dev",
  "bugs": "https://github.com/Primitivelabai/lettuce/issues",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.7.0"
  }
}
